# ═══════════════════════════════════════════════════════════════
# CineForge — 100% FREE LOCAL MODE
# Zero API keys. Zero cloud calls. Zero cost.
# ═══════════════════════════════════════════════════════════════

# === LLM Director (Ollama — FREE, LOCAL) ===
# Install Ollama from https://ollama.com/download
# Then pull models: ollama pull qwen3:32b  (or qwen3:7b for 8GB RAM)
LITELLM_PROVIDER=ollama/qwen3:32b

# === Video Generation (Wan2GP / ComfyUI — FREE, LOCAL) ===
# Install Wan2GP: https://github.com/deepbeepmeep/Wan2GP
# Or install ComfyUI: https://github.com/comfyanonymous/ComfyUI
# No keys needed — runs on your GPU (6GB+ VRAM for Wan2GP)

# === Reference Images (Local Diffusers — FREE, LOCAL) ===
# First run will download ~4GB SDXL model. No keys.
# For CPU-only: very slow (~5 min per image). GPU recommended.

# === TTS (Piper — FREE, LOCAL) ===
# Install Piper: https://github.com/rhasspy/piper/releases
# Download voice model and place in ~/.piper/

# === Embedder (BGE-small — FREE, LOCAL) ===
# Auto-downloads on first use (~100MB). CPU-friendly.

# === CineForge Settings ===
CINEFORGE_PORT=8765
CINEFORGE_DATA_DIR=~/.cineforge

# === Routing Profile ===
# Use "local_two_stage" for 100% local workflow
# Use "hybrid" if you later add a free cloud LLM tier (see below)
CINEFORGE_DEFAULT_PROFILE=local_two_stage

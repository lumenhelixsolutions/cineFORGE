# CineForge Environment Configuration
# Copy to .env and fill in your keys

# Google Cloud (for Vertex Veo)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# fal.ai API key (for cloud video + FLUX ref images)
FAL_KEY=your-fal-key

# LiteLLM / Anthropic (for LLM director)
ANTHROPIC_API_KEY=your-anthropic-key
LITELLM_PROVIDER=anthropic/claude-sonnet-4-6

# OpenAI (optional, via LiteLLM)
OPENAI_API_KEY=your-openai-key

# CineForge settings
CINEFORGE_PORT=8765
CINEFORGE_DATA_DIR=~/.cineforge
CINEFORGE_MOCK_VIDEO=false
CINEFORGE_MOCK_LLM=false
